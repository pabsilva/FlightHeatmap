# Mapbox public token (pk.*) - https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=pk.your_token_here

# Data source: combined | fr24-public | adsblol | adsbfi | fr24 | opensky
#   combined    : fr24-public + adsblol merged per aircraft (best coverage, recommended)
#   fr24-public : the feed the flightradar24.com website uses. No key, personal use only (see README).
#   adsblol     : adsb.lol open data (ODbL), no key. Fewer light aircraft than FR24.
#   adsbfi      : adsb.fi open data, no key, personal/non-commercial use, max 1 request/s.
#   fr24        : official Flightradar24 API (https://fr24api.flightradar24.com), needs FR24_API_TOKEN.
#   opensky     : OpenSky Network REST API, optional OAuth client credentials.
SOURCE=combined
FR24_API_TOKEN=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Seconds between polls. Default depends on SOURCE (20; fr24: 30, opensky: 60)
POLL_INTERVAL=

# Regions to cover, comma separated: mainland,madeira,azores
REGIONS=mainland

# Grid cell size in degrees (0.01 is about 1 km)
CELL_SIZE=0.01

# Rebuild the heatmap every N minutes while the collector runs
REBUILD_EVERY_MIN=30

PORT=3000
